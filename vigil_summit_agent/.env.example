# =============================================================================
# Vigil Summit Agent — variáveis de ambiente (.env.example)
# =============================================================================
# 1. Copie este arquivo:  copy .env.example .env   (Windows)
#                        cp .env.example .env     (Linux/Mac)
# 2. Escolha UM provedor de LLM abaixo (Anthropic ou Groq).
# 3. Preencha APENAS a chave do provedor escolhido.
# 4. NUNCA commite o arquivo .env (já está no .gitignore).
# =============================================================================

# --- Provedor de LLM (escolha um) -------------------------------------------
# anthropic = Claude 3.5 Sonnet (preferência do case, melhor copy)
# groq      = Llama 3.3 70B via Groq (free tier, bom para testes sem custo)
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) — use se LLM_PROVIDER=anthropic ---------------------
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=seu_token_aqui
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Groq — use se LLM_PROVIDER=groq ----------------------------------------
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Outras configurações (opcional) ----------------------------------------
# VIGIL_EVENT_DATE=2026-06-30
# CORS_ORIGINS=*
# VIGIL_API_URL=https://vigil-summit-api.onrender.com
# VIGIL_API_KEY=defina_a_mesma_chave_no_Render
# ENABLE_SCHEDULER=true   # só na API (Render): régua automática diária
APP_PASSWORD=vigil2026
