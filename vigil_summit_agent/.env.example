# Provedor de LLM ativo: "anthropic" (melhor opção) ou "groq" (gratuito p/ testes)
LLM_PROVIDER=groq

# Chaves de API (preencha a do provedor que for usar)
ANTHROPIC_API_KEY=seu_token_aqui
GROQ_API_KEY=sua_chave_groq_aqui

# (Opcional) Sobrescrever modelos
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# GROQ_MODEL=llama-3.3-70b-versatile

# (Opcional) Data do evento
# VIGIL_EVENT_DATE=2026-06-30

# (Opcional) CORS da API de captação (* = qualquer origem; padrao)
# CORS_ORIGINS=*

# API de captação (Render) — use no Streamlit Cloud para ver leads da LP
# VIGIL_API_URL=https://vigil-summit-api.onrender.com
# VIGIL_API_KEY=defina_a_mesma_chave_no_Render

# Senha de acesso ao painel (login sempre ativo; padrao: vigil2026)
APP_PASSWORD=vigil2026
