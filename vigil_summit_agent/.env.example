# Provedor de LLM ativo: "anthropic" (padrão) ou "groq" (gratuito p/ testes)
LLM_PROVIDER=anthropic

# Chaves de API (preencha a do provedor que for usar)
ANTHROPIC_API_KEY=seu_token_aqui
GROQ_API_KEY=seu_token_aqui

# (Opcional) Sobrescrever modelos
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# GROQ_MODEL=llama-3.3-70b-versatile

# (Opcional) Data do evento
# VIGIL_EVENT_DATE=2026-06-30

# Senha de acesso ao painel (login sempre ativo; padrao: vigil2026)
APP_PASSWORD=vigil2026
